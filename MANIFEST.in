include ARCHITECTURE.md
include CHANGELOG.md
include LICENSE
include MIGRATION.md
include README.md
include SECURITY.md
include VERIFICATION.txt
recursive-include docs *.md
recursive-include examples *.py *.json *.toml *.md
recursive-include scripts *.py *.sh
recursive-include tests *.py
recursive-include profiles *.json *.toml *.md *.asc
recursive-include release-keys *.asc
include root.json root.json.key-*.asc
include wheel-release-manifest.json wheel-release-manifest.json.key-*.asc
include wheel-protected-manifest.json wheel-protected-manifest.json.key-*.asc
include setup.py
prune .pytest_cache
global-exclude __pycache__
global-exclude *.py[cod]
